{
  "ARVI2": {
    "name": "ARVI2",
    "domain": "Vegetation",
    "formula": "-0.18 + 1.17 * ((N − R) / (N + R))",
    "description": "The Atmospherically Resistant Vegetation Index is more resistant to atmospheric effects compared to the NDVI",
    "reference": "https://doi.org/10.1109/36.134076",
    "sourceName": "Index DataBase (IDB)",
    "sourceUrl": "https://www.indexdatabase.de"
  },
  "BRI": {
    "name": "BRI",
    "domain": "Vegetation",
    "formula": "(1 / G - 1 / RE1) / N",
    "description": "Browning Reflectance Index - For the quantification of tissue browning",
    "reference": "http://dx.doi.org/10.1023/A:1025608728405",
    "sourceName": "Index DataBase (IDB)",
    "sourceUrl": "https://www.indexdatabase.de"
  },
  "CCCI": {
    "name": "CCCI",
    "domain": "Vegetation",
    "formula": "((N-RE1) / (N+RE1)) / ((N-R) / (N+R))",
    "description": "Canopy Chlorophyll Content Index",
    "reference": "https://doi.org/10.1016/j.fcr.2010.01.010",
    "sourceName": "Index DataBase (IDB)",
    "sourceUrl": "https://www.indexdatabase.de"
  },
  "Chlgreen": {
    "name": "Chlgreen",
    "domain": "Vegetation",
    "formula": "pow(N / G, -1)",
    "description": "Chlorophyll Green",
    "reference": "http://dx.doi.org/10.1029/2006GL026457",
    "sourceName": "Index DataBase (IDB)",
    "sourceUrl": "https://www.indexdatabase.de"
  },
  "CIgreen": {
    "name": "CIgreen",
    "domain": "Vegetation",
    "formula": "(N / G) - 1",
    "description": "Chlorophyll Index Green",
    "reference": "https://doi.org/10.1029/2002GL016450",
    "sourceName": "Index DataBase (IDB)",
    "sourceUrl": "https://www.indexdatabase.de"
  },
  "CI": {
    "name": "CI",
    "domain": "Vegetation",
    "formula": "(R - B) / R",
    "description": "Coloration Index",
    "reference": "https://isprs-archives.copernicus.org/articles/XLI-B2/43/2016/isprs-archives-XLI-B2-43-2016.pdf",
    "sourceName": "Index DataBase (IDB)",
    "sourceUrl": "https://www.indexdatabase.de"
  },
  "CTVI": {
    "name": "CTVI",
    "domain": "Vegetation",
    "formula": "(((N - R)/(N + R) + 0.5) /abs((N - R)/(N + R)+0.5)) * sqrt(abs((N - R)/(N + R) + 0.5))",
    "description": "Corrected Transformed Vegetation Index",
    "reference": "http://dx.doi.org/10.1016/0034-4257%2884%2990013-0",
    "sourceName": "Index DataBase (IDB)",
    "sourceUrl": "https://www.indexdatabase.de"
  },
  "FR": {
    "name": "FR",
    "domain": "Vegetation",
    "formula": "R / RE2",
    "description": "Simple Fluorescence Ratio",
    "reference": "https://doi.org/10.1016/S0176-1617(96)80070-8",
    "sourceName": "Index DataBase (IDB)",
    "sourceUrl": "https://www.indexdatabase.de"
  },
  "FIR": {
